  "strings" : {
    "NSCameraUsageDescription" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте экран тонометра, чтобы распознать значения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía la pantalla del tensiómetro para leer los valores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere das Display des Messgeräts, um die Werte zu lesen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄血压计屏幕以读取数值。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать последние измерения давления и тренд на главном экране."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tus mediciones recientes de presión arterial y la tendencia en la pantalla principal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deine letzten Blutdruckwerte und den Verlauf auf dem Hauptbildschirm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕上显示最近的血压读数和趋势。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
